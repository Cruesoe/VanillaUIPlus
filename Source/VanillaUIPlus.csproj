<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build settings, RimWorld references and the copy into 1.6\Assemblies all come
       from _ModKit via the Directory.Build.props/.targets at the repo root. The old
       in-build deploy into the Mods folder is now Publish-Mod's job. -->
  <PropertyGroup>
    <RootNamespace>VanillaUIPlus</RootNamespace>
    <AssemblyName>VanillaUIPlus</AssemblyName>
    <Nullable>enable</Nullable>
    <UnityModules>CoreModule;IMGUIModule;TextRenderingModule</UnityModules>
  </PropertyGroup>
</Project>
