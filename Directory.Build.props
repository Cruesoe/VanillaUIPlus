<Project>
  <PropertyGroup>
    <ModRepoRoot>$(MSBuildThisFileDirectory)</ModRepoRoot>
    <ModKitRoot Condition="'$(ModKitRoot)' == ''">$(RIMWORLD_MODKIT)</ModKitRoot>
    <ModKitRoot Condition="'$(ModKitRoot)' == ''">$(MSBuildThisFileDirectory)..\_ModKit</ModKitRoot>
    <ModKitRoot>$([MSBuild]::EnsureTrailingSlash('$(ModKitRoot)'))</ModKitRoot>

    <!--
      _ModKit is a plain local folder that this repo does not carry, so a fresh clone on
      another machine will not have it. Without the guard below that surfaces as
      "NETSDK1013: The TargetFramework value '' was not recognized", which says nothing
      about the real cause. Keep evaluation valid instead and let Directory.Build.targets
      raise a readable error.
    -->
    <ModKitProps>$(ModKitRoot)RimWorldMod.props</ModKitProps>
    <ModKitMissing Condition="!Exists('$(ModKitProps)')">true</ModKitMissing>
    <TargetFramework Condition="'$(ModKitMissing)' == 'true'">net472</TargetFramework>
  </PropertyGroup>

  <!--
    Cloud / Linux build support for Vanilla UI+.

    This block only takes effect on non-Windows hosts (Cloud Agents, CI) AND only
    when the local reference assemblies produced by .cursor/install.sh are present.
    On Windows it is a complete no-op, so the normal workflow of building against a
    real RimWorld install is left exactly as-is.

    It has to run BEFORE the _ModKit import below: the kit fills RimWorldRoot and
    HarmonyDll in only when they are still empty, so whatever is set here wins and the
    kit does not fall through to the default Steam path.
  -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <_VuipRefsDir>$(MSBuildThisFileDirectory).cursor/refs</_VuipRefsDir>

    <RimWorldRoot Condition="'$(RimWorldRoot)' == '' and '$(RIMWORLD_DIR)' == '' and Exists('$(_VuipRefsDir)/rimworld/RimWorldWin64_Data/Managed/Assembly-CSharp.dll')">$(_VuipRefsDir)/rimworld</RimWorldRoot>
    <HarmonyDll Condition="'$(HarmonyDll)' == '' and '$(HARMONY_DLL)' == '' and Exists('$(_VuipRefsDir)/harmony/0Harmony.dll')">$(_VuipRefsDir)/harmony/0Harmony.dll</HarmonyDll>

    <!-- Provide the .NET Framework 4.7.2 reference assemblies so the SDK can target net472 without Mono. -->
    <FrameworkPathOverride Condition="'$(FrameworkPathOverride)' == '' and Exists('$(_VuipRefsDir)/framework/net472/mscorlib.dll')">$(_VuipRefsDir)/framework/net472</FrameworkPathOverride>
  </PropertyGroup>

  <Import Project="$(ModKitProps)" Condition="'$(ModKitMissing)' != 'true'" />

  <!--
    Unity's publicized reference assemblies forward core types (ValueType, Enum, ...)
    to netstandard 2.1, which is not part of .NET Framework 4.7.2. Reference the
    netstandard facade that ships with the RimWorld managed assemblies to satisfy them.
  -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT' and Exists('$(_VuipRefsDir)/rimworld/RimWorldWin64_Data/Managed/netstandard.dll')">
    <Reference Include="netstandard">
      <HintPath>$(_VuipRefsDir)/rimworld/RimWorldWin64_Data/Managed/netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
